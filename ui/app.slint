                Button { x: 18px; y: 410px; width: 292px; height: 36px; text: root.editing-id == 0 ? "Add server" : "Save changes"; primary: true; clicked => { root.save-server(root.editing-id, root.editing-name, root.editing-ip-address, root.editing-ports, root.editing-environment, root.editing-status, root.editing-purpose, root.editing-tags); } }
                if root.status-message != "": Text { x: 18px; y: 454px; width: 292px; text: (root.status-is-error ? "Save failed · " : "Saved · ") + root.status-message; color: root.status-is-error ? #a33a32 : #16715e; font-size: root.body-font-size; font-weight: 650; wrap: word-wrap; accessible-role: text; accessible-label: self.text; }
