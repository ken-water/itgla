import { Button, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct ServerRow { id: int, tags: string, ip-address: string, ports: string, custom-values: [string] }
export struct ImportColumnRow { index: int, source-name: string, sample: string, mapping-index: int }

component DataCell inherits Rectangle {
    in property <string> value;
    in property <string> copy-label;
    callback copy(string, string);
    background: transparent;
    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #edf0ef; }
    Text { x: 8px; y: 0; width: parent.width - 58px; height: parent.height; text: root.value; color: #27312d; font-size: 11px; vertical-alignment: center; overflow: elide; }
    Button { x: parent.width - 50px; y: 6px; width: 44px; height: 28px; text: "Copy"; clicked => { root.copy(root.value, root.copy-label); } }
}

component HeaderCell inherits Rectangle {
    in property <string> title;
    background: #edf2ef;
    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #dce3e0; }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.title; color: #61706a; font-size: 9px; font-weight: 700; vertical-alignment: center; overflow: elide; }
}

component ServerTableRow inherits Rectangle {
    in property <ServerRow> item;
    in property <[string]> custom-headers;
    in property <length> table-width;
    callback edit; callback archive; callback copy(string, string);
    width: root.table-width; height: 40px; background: #ffffff;
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #e6ebe8; }
    HorizontalLayout {
        spacing: 0px;
        DataCell { width: 180px; value: root.item.tags; copy-label: "Tags"; copy(value, label) => { root.copy(value, label); } }
        DataCell { width: 160px; value: root.item.ip-address; copy-label: "IP address"; copy(value, label) => { root.copy(value, label); } }
        DataCell { width: 130px; value: root.item.ports; copy-label: "Ports"; copy(value, label) => { root.copy(value, label); } }
        for value[index] in root.item.custom-values: DataCell { width: 160px; value: value; copy-label: root.custom-headers[index]; copy(cell-value, label) => { root.copy(cell-value, label); } }
        Rectangle {
            width: 116px; background: transparent;
            Button { x: 5px; y: 6px; width: 44px; height: 28px; text: "Edit"; clicked => { root.edit(); } }
            Button { x: 53px; y: 6px; width: 58px; height: 28px; text: "Archive"; clicked => { root.archive(); } }
        }
    }
}

component TableHeader inherits Rectangle {
    in property <[string]> custom-headers;
    in property <length> table-width;
    width: root.table-width; height: 32px; background: #edf2ef; border-width: 1px; border-color: #dce3e0;
    HorizontalLayout {
        spacing: 0px;
        HeaderCell { width: 180px; title: "TAGS"; }
        HeaderCell { width: 160px; title: "IP ADDRESS"; }
        HeaderCell { width: 130px; title: "PORTS"; }
        for header in root.custom-headers: HeaderCell { width: 160px; title: header; }
        HeaderCell { width: 116px; title: "ACTIONS"; }
    }
}

component TagChoice inherits Rectangle {
    in property <string> label; in property <bool> selected; callback chosen;
    height: 32px; background: root.selected ? #dceee8 : transparent; border-radius: 4px;
    Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.label; color: root.selected ? #0f5f50 : #44504b; font-size: 11px; font-weight: root.selected ? 700 : 500; vertical-alignment: center; overflow: elide; }
    TouchArea { clicked => { root.chosen(); } }
}

component ImportMappingRow inherits Rectangle {
    in property <ImportColumnRow> column;
    in property <[string]> mapping-options;
    callback mapping-changed(int, int);
    height: 62px; background: #ffffff;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e5e9e7; }
    Text { x: 8px; y: 8px; width: 210px; text: root.column.source-name; color: #26312d; font-size: 11px; font-weight: 700; overflow: elide; }
    Text { x: 8px; y: 31px; width: 300px; text: root.column.sample == "" ? "No sample value" : root.column.sample; color: #7a8581; font-size: 9px; overflow: elide; }
    mapping-box := ComboBox {
        x: parent.width - 250px; y: 13px; width: 242px; height: 36px;
        model: root.mapping-options; current-index: root.column.mapping-index;
        selected(value) => { root.mapping-changed(root.column.index, mapping-box.current-index); }
    }
}

export component AppWindow inherits Window {
    title: "ITGLA - Server Inventory";
    preferred-width: 1180px; preferred-height: 760px; min-width: 1000px; min-height: 640px; background: #f4f7f5;
    in property <[ServerRow]> servers;
    in property <[string]> available-tags;
    in property <[string]> custom-headers;
    in property <int> custom-column-count;
    in property <[string]> sort-options;
    in property <int> server-count;
    in-out property <string> active-tag;
    in-out property <int> sort-mode-index: 0;
    in-out property <int> editing-id: 0;
    in-out property <string> editing-tags;
    in-out property <string> editing-ip-address;
    in-out property <string> editing-ports;
    in-out property <int> archive-target-id: 0;
    in-out property <string> status-message;
    in-out property <bool> status-is-error: false;
    in-out property <bool> import-dialog-open: false;
    in-out property <string> import-file-path;
    in-out property <[ImportColumnRow]> import-columns;
    in-out property <[string]> import-mapping-options;
    in-out property <int> import-row-count;
    in-out property <bool> import-ready: false;
    in-out property <string> import-error;
    property <length> table-width: 586px + root.custom-column-count * 160px;
    callback search-changed(string);
    callback tag-selected(string);
    callback sort-mode-selected(int);
    callback save-server(int, string, string, string);
    callback archive-server(int);
    callback copy-value(string, string);
    callback choose-import-file;
    callback load-import(string);
    callback import-mapping-changed(int, int);
    callback confirm-import;

    Rectangle {
        x: 0; y: 0; width: parent.width; height: 64px; background: #ffffff;
        Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #dce3e0; }
        Text { x: 28px; y: 12px; text: "ITGLA"; color: #102f29; font-size: 19px; font-weight: 800; }
        Text { x: 28px; y: 37px; text: "Server inventory"; color: #6d7874; font-size: 10px; }
        Text { x: parent.width - 266px; y: 23px; width: 90px; text: root.server-count + (root.server-count == 1 ? " server" : " servers"); color: #52605b; font-size: 11px; horizontal-alignment: right; }
        Button { x: parent.width - 164px; y: 14px; width: 136px; height: 36px; text: "Import table"; clicked => { root.import-error = ""; root.import-dialog-open = true; } }
    }

    Rectangle {
        x: 28px; y: 84px; width: parent.width - 412px; height: parent.height - 108px; background: transparent;
        Text { x: 0; y: 0; text: root.active-tag == "" ? "All servers" : "Servers tagged " + root.active-tag; color: #17201d; font-size: 20px; font-weight: 700; }
        LineEdit { x: 0; y: 38px; width: parent.width - 214px; height: 34px; placeholder-text: "Search any cell"; edited(value) => { root.search-changed(value); } }
        sort-box := ComboBox { x: parent.width - 204px; y: 38px; width: 204px; height: 34px; model: root.sort-options; current-index <=> root.sort-mode-index; selected(value) => { root.sort-mode-selected(sort-box.current-index); } }
        Rectangle {
            x: 0; y: 84px; width: parent.width; height: parent.height - 84px; background: #ffffff; border-width: 1px; border-color: #dce3e0;
            ScrollView {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                VerticalLayout {
                    width: root.table-width; spacing: 0px;
                    TableHeader { custom-headers: root.custom-headers; table-width: root.table-width; }
                    for server in root.servers: ServerTableRow {
                        item: server; custom-headers: root.custom-headers; table-width: root.table-width;
                        edit => { root.editing-id = server.id; root.editing-tags = server.tags; root.editing-ip-address = server.ip-address; root.editing-ports = server.ports; root.status-message = ""; }
                        archive => { root.archive-target-id = server.id; }
                        copy(value, label) => { root.copy-value(value, label); }
                    }
                }
            }
            if root.server-count == 0: Text { y: 94px; width: parent.width; text: "No servers match the current filters."; color: #77817d; font-size: 11px; horizontal-alignment: center; }
        }
    }

    Rectangle {
        x: parent.width - 356px; y: 84px; width: 328px; height: parent.height - 108px; background: #ffffff; border-width: 1px; border-color: #dce3e0; border-radius: 6px;
        Text { x: 18px; y: 16px; text: root.editing-id == 0 ? "Add server" : "Edit server"; color: #17201d; font-size: 17px; font-weight: 700; }
        if root.editing-id != 0: Button { x: 224px; y: 10px; width: 84px; height: 30px; text: "New"; clicked => { root.editing-id = 0; root.editing-tags = ""; root.editing-ip-address = ""; root.editing-ports = ""; root.status-message = ""; } }
        Text { x: 18px; y: 58px; text: "TAGS"; color: #5f6b67; font-size: 9px; font-weight: 700; }
        LineEdit { x: 18px; y: 76px; width: 292px; height: 34px; placeholder-text: "production, api, customer-facing"; text <=> root.editing-tags; }
        Text { x: 18px; y: 120px; text: "IP ADDRESS"; color: #5f6b67; font-size: 9px; font-weight: 700; }
        LineEdit { x: 18px; y: 138px; width: 292px; height: 34px; placeholder-text: "203.0.113.10"; text <=> root.editing-ip-address; }
        Text { x: 18px; y: 182px; text: "PORTS"; color: #5f6b67; font-size: 9px; font-weight: 700; }
        LineEdit { x: 18px; y: 200px; width: 292px; height: 34px; placeholder-text: "22, 80, 443"; text <=> root.editing-ports; }
        Text { x: 18px; y: 242px; width: 292px; text: "Separate tags and ports with commas. Duplicates are removed."; color: #7a8581; font-size: 9px; wrap: word-wrap; }
        Button { x: 18px; y: 278px; width: 292px; height: 36px; text: root.editing-id == 0 ? "Add server" : "Save changes"; clicked => { root.save-server(root.editing-id, root.editing-tags, root.editing-ip-address, root.editing-ports); } }
        if root.status-message != "": Text { x: 18px; y: 322px; width: 292px; text: root.status-message; color: root.status-is-error ? #a33a32 : #16715e; font-size: 10px; wrap: word-wrap; }
        Rectangle { x: 18px; y: 364px; width: 292px; height: 1px; background: #e2e7e5; }
        Text { x: 18px; y: 382px; text: "FILTER BY TAG"; color: #5f6b67; font-size: 9px; font-weight: 700; }
        ScrollView {
            x: 18px; y: 406px; width: 292px; height: parent.height - 424px;
            VerticalLayout {
                spacing: 3px;
                TagChoice { label: "All servers"; selected: root.active-tag == ""; chosen => { root.tag-selected(""); } }
                for tag in root.available-tags: TagChoice { label: tag; selected: root.active-tag == tag; chosen => { root.tag-selected(tag); } }
            }
        }
    }

    if root.archive-target-id != 0: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 210px) / 2; width: 380px; height: 210px; background: #ffffff; border-radius: 6px;
            Text { x: 24px; y: 24px; text: "Archive this server?"; color: #17201d; font-size: 18px; font-weight: 700; }
            Text { x: 24px; y: 64px; width: 332px; text: "It will be hidden from the inventory. The record remains in your local database."; color: #65706c; font-size: 11px; wrap: word-wrap; }
            Button { x: 172px; y: 146px; width: 84px; height: 36px; text: "Cancel"; clicked => { root.archive-target-id = 0; } }
            Button { x: 268px; y: 146px; width: 88px; height: 36px; text: "Archive"; clicked => { root.archive-server(root.archive-target-id); } }
        }
    }

    if root.import-dialog-open: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 760px) / 2; y: (parent.height - 590px) / 2; width: 760px; height: 590px; background: #ffffff; border-radius: 6px;
            Text { x: 24px; y: 20px; text: "Import a table"; color: #17201d; font-size: 19px; font-weight: 700; }
            Text { x: 24px; y: 49px; text: "Excel, OpenDocument, CSV, or TSV · first row contains column names"; color: #6d7874; font-size: 10px; }
            LineEdit { x: 24px; y: 78px; width: 474px; height: 36px; placeholder-text: "Choose a table or enter its full path"; text <=> root.import-file-path; }
            Button { x: 510px; y: 78px; width: 102px; height: 36px; text: "Browse"; clicked => { root.choose-import-file(); } }
            Button { x: 624px; y: 78px; width: 112px; height: 36px; text: "Load file"; clicked => { root.load-import(root.import-file-path); } }
            Text { x: 24px; y: 132px; text: root.import-ready ? root.import-row-count + " rows ready · map every source column" : "Load a file to configure column mapping"; color: #46534e; font-size: 11px; font-weight: 600; }
            if root.import-ready: Rectangle {
                x: 24px; y: 156px; width: 712px; height: 328px; background: #ffffff; border-width: 1px; border-color: #dce3e0;
                ScrollView {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    VerticalLayout {
                        spacing: 0px;
                        for column in root.import-columns: ImportMappingRow { column: column; mapping-options: root.import-mapping-options; mapping-changed(source-index, mapping-index) => { root.import-mapping-changed(source-index, mapping-index); } }
                    }
                }
            }
            if root.import-error != "": Text { x: 24px; y: 498px; width: 530px; text: root.import-error; color: #a33a32; font-size: 10px; wrap: word-wrap; }
            Button { x: 532px; y: 532px; width: 94px; height: 36px; text: "Cancel"; clicked => { root.import-dialog-open = false; } }
            Button { x: 638px; y: 532px; width: 98px; height: 36px; text: "Import"; enabled: root.import-ready; clicked => { root.confirm-import(); } }
        }
    }
}
