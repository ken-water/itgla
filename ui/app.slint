        VerticalLayout { x: 24px; y: 122px; width: parent.width - 48px; spacing: 0px; for operation in root.operations: Rectangle { height: 56px; background: UiColors.surface; Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e1e7df; } Text { x: 12px; width: 250px; height: parent.height; text: operation.publish-at; color: #25342d; font-size: root.body-font-size; vertical-alignment: center; } Text { x: 262px; width: 180px; height: parent.height; text: operation.media; color: #25342d; font-size: root.body-font-size; vertical-alignment: center; } Text { x: 442px; width: 320px; height: parent.height; text: operation.channel; color: #56685e; font-size: root.body-font-size; vertical-alignment: center; } } }
        FieldLabel { x: 24px; y: parent.height - 76px; text: "Media values"; token-size: root.body-font-size; }
        media-box := ComboBox { x: 120px; y: parent.height - 84px; width: 130px; height: 32px; model: root.media-options; current-index: root.media-index; selected(value) => { root.media-index = media-box.current-index; } }
        LineEdit { x: 262px; y: parent.height - 84px; width: 180px; height: 32px; placeholder-text: "Add custom media"; text <=> root.media-input; }
        Button { x: 450px; y: parent.height - 84px; width: 90px; height: 32px; text: "Add"; clicked => { root.add-media(root.media-input); } }
        Button { x: 546px; y: parent.height - 84px; width: 90px; height: 32px; text: "Remove"; clicked => { root.remove-media(root.media-index); } }
        HelperText { x: 24px; y: parent.height - 42px; text: "X, TikTok, and Media start as presets; custom values can be added or removed."; token-size: root.body-font-size; }
    }

    if root.active-tab == 12: Rectangle {
        x: 28px; y: 138px; width: parent.width - 56px; height: parent.height - 162px; background: transparent;
        PageHeader { x: 0; y: 0; text: "Work inbox"; token-size: root.page-title-font-size; }
        SectionLabel { x: 0; y: 34px; text: "PLAN THE CHANGE BEFORE THE CHANGE PLANS YOU"; token-size: root.caption-font-size; }
        Button { x: parent.width - 132px; y: -4px; width: 132px; height: 32px; text: "+  New work"; clicked => { root.new-work(); } }
        work-search := LineEdit { x: 10px; y: 68px; width: parent.width * 0.46 - 314px; height: 32px; placeholder-text: "Search work"; text <=> root.work-list-query; edited => { root.work-list-filter-changed(root.work-list-query, root.work-list-kind-filter, root.work-list-status-filter, root.work-list-sort-mode); } }
        kind-filter := ComboBox { x: parent.width * 0.46 - 294px; y: 68px; width: 90px; height: 32px; model: ["All types", "Change", "Task", "Renewal", "Incident", "Migration", "Launch", "Maintenance"]; current-index <=> root.work-list-kind-filter; selected(value) => { root.work-list-filter-changed(root.work-list-query, root.work-list-kind-filter, root.work-list-status-filter, root.work-list-sort-mode); } }
        status-filter := ComboBox { x: parent.width * 0.46 - 198px; y: 68px; width: 90px; height: 32px; model: ["All status", "Inbox", "Planned", "Ready", "In progress", "Blocked", "Done", "Cancelled"]; current-index <=> root.work-list-status-filter; selected(value) => { root.work-list-filter-changed(root.work-list-query, root.work-list-kind-filter, root.work-list-status-filter, root.work-list-sort-mode); } }
        work-sort := ComboBox { x: parent.width * 0.46 - 102px; y: 68px; width: 92px; height: 32px; model: ["Default", "Priority", "Due date", "Status", "Title"]; current-index <=> root.work-list-sort-mode; selected(value) => { root.work-list-filter-changed(root.work-list-query, root.work-list-kind-filter, root.work-list-status-filter, root.work-list-sort-mode); } }
        work-page-scroll := ScrollView {
        y: 108px; width: parent.width; height: parent.height - 108px;
        content-y <=> root.work-page-scroll-y;
        work-content := Rectangle {
        width: work-page-scroll.width; height: 744px; background: transparent;
        Timer {
            interval: 50ms;
            running: root.work-view-reset-pending;
            triggered => { servers-tab.focus(); work-page-scroll.content-y = 0px; root.work-page-scroll-y = 0px; root.work-view-reset-pending = false; }
        }
        Rectangle { x: 0; y: 0; width: parent.width * 0.46; height: parent.height; background: UiColors.surface; border-width: 1px; border-color: #d3ddd4; }
        ScrollView { x: 1px; y: 52px; width: parent.width * 0.46 - 2px; height: parent.height - 53px; accessible-role: list; accessible-label: "Work items"; VerticalLayout { width: parent.width; spacing: 0px; for item in root.work-items: WorkListRow { item: item; title-font-size: root.body-font-size; metadata-font-size: root.caption-font-size; selected(id) => { root.work-selected(id); } quick-status(id, status) => { root.work-quick-status(id, status); } } } }
        if root.work-items.length == 0: Text { x: 28px; y: 86px; width: parent.width * 0.38; text: root.work-list-query == "" && root.work-list-kind-filter == 0 && root.work-list-status-filter == 0 ? "No work yet. Create a change, task, or renewal to keep the next action visible." : "No work matches the current filters."; color: #66716c; font-size: root.small-font-size; wrap: word-wrap; }
        Rectangle { x: parent.width * 0.46 + 18px; y: 0; width: parent.width * 0.54 - 18px; height: parent.height; background: #f8faf6; border-width: 1px; border-color: #d3ddd4; border-radius: 6px; }
        PanelTitle { x: parent.width * 0.46 + 42px; y: 22px; text: root.selected-work-id == 0 ? "New work" : "Work details"; token-size: root.panel-title-font-size; }
        Button { x: parent.width - 132px; y: 14px; width: 100px; height: 30px; text: "Archive"; enabled: root.selected-work-id != 0; clicked => { root.archive-work(root.selected-work-id); } }
        Button { x: parent.width - 244px; y: 14px; width: 104px; height: 30px; text: "Checklist"; enabled: root.selected-work-id != 0; clicked => { root.checklist-dialog-open = true; } }
        FieldLabel { x: parent.width * 0.46 + 42px; y: 62px; text: "TITLE"; token-size: root.caption-font-size; }
        LineEdit { x: parent.width * 0.46 + 42px; y: 80px; width: parent.width * 0.54 - 84px; height: 36px; placeholder-text: "Renew production API certificate"; text <=> root.work-title; }
        FieldLabel { x: parent.width * 0.46 + 42px; y: 130px; text: "TYPE / STATUS / PRIORITY"; token-size: root.caption-font-size; }
        kind-box := ComboBox { x: parent.width * 0.46 + 42px; y: 148px; width: 118px; height: 34px; model: ["Change", "Task", "Renewal", "Incident", "Migration", "Launch", "Maintenance"]; current-index <=> root.work-kind-index; selected(value) => { root.work-kind = root.work-kind-index == 0 ? "change" : root.work-kind-index == 1 ? "task" : root.work-kind-index == 2 ? "renewal" : root.work-kind-index == 3 ? "incident" : root.work-kind-index == 4 ? "migration" : root.work-kind-index == 5 ? "launch" : "maintenance"; } }
        status-box := ComboBox { x: parent.width * 0.46 + 168px; y: 148px; width: 136px; height: 34px; model: ["Inbox", "Planned", "Ready", "In progress", "Blocked", "Done", "Cancelled"]; current-index <=> root.work-status-index; selected(value) => { root.work-status = root.work-status-index == 0 ? "inbox" : root.work-status-index == 1 ? "planned" : root.work-status-index == 2 ? "ready" : root.work-status-index == 3 ? "in_progress" : root.work-status-index == 4 ? "blocked" : root.work-status-index == 5 ? "done" : "cancelled"; } }
        LineEdit { x: parent.width * 0.46 + 312px; y: 148px; width: 92px; height: 34px; placeholder-text: "P2"; text <=> root.work-priority; }
        FieldLabel { x: parent.width * 0.46 + 42px; y: 196px; text: "OWNER / DATES"; token-size: root.caption-font-size; }
        owner-edit := LineEdit { x: parent.width * 0.46 + 42px; y: 214px; width: 150px; height: 34px; placeholder-text: "Owner"; text <=> root.work-owner; }
        due-edit := LineEdit { x: parent.width * 0.46 + 204px; y: 214px; width: 150px; height: 34px; placeholder-text: "Due date or window"; text <=> root.work-due-at; }
        LineEdit { x: parent.width * 0.46 + 366px; y: 214px; width: 150px; height: 34px; placeholder-text: "Start date"; text <=> root.work-start-at; }
        FieldLabel { x: parent.width * 0.46 + 42px; y: 262px; text: "NOTES"; token-size: root.caption-font-size; }
        LineEdit { x: parent.width * 0.46 + 42px; y: 280px; width: parent.width * 0.54 - 84px; height: 70px; placeholder-text: "What must be true when this work is done?"; text <=> root.work-notes; }
        Button { x: parent.width * 0.46 + 42px; y: 368px; width: 160px; height: 36px; text: root.selected-work-id == 0 ? "Create work" : "Save work"; clicked => { root.save-work(root.selected-work-id, root.work-title, root.work-kind, root.work-status, root.work-priority, root.work-owner, root.work-start-at, root.work-due-at, root.work-notes); } }
        Text { x: parent.width * 0.46 + 220px; y: 378px; width: parent.width * 0.54 - 262px; text: "Scope: " + root.work-project-count + " projects · " + root.work-server-count + " servers · " + root.work-asset-count + " resources"; color: #176b59; font-size: root.tiny-font-size; wrap: word-wrap; }
        FieldLabel { x: parent.width * 0.46 + 42px; y: 422px; text: "PROJECTS"; token-size: root.caption-font-size; }
        ScrollView { x: parent.width * 0.46 + 42px; y: 440px; width: (parent.width * 0.54 - 100px) / 2; height: 112px; VerticalLayout { spacing: 2px; for project in root.work-projects: ChoiceRow { height: 30px; label: project.name; selected: project.selected; label-font-size: root.caption-font-size; toggled => { root.work-project-toggled(project.id, !project.selected); } } } }
        FieldLabel { x: parent.width * 0.46 + 54px + (parent.width * 0.54 - 100px) / 2; y: 422px; text: "SERVERS"; token-size: root.caption-font-size; }
        ScrollView { x: parent.width * 0.46 + 54px + (parent.width * 0.54 - 100px) / 2; y: 440px; width: (parent.width * 0.54 - 100px) / 2; height: 112px; VerticalLayout { spacing: 2px; for server in root.work-servers: ChoiceRow { height: 30px; label: server.label; selected: server.selected; label-font-size: root.caption-font-size; toggled => { root.work-server-toggled(server.id, !server.selected); } } } }
        FieldLabel { x: parent.width * 0.46 + 42px; y: 562px; text: "RESOURCES"; token-size: root.caption-font-size; }
        ScrollView { x: parent.width * 0.46 + 42px; y: 580px; width: parent.width * 0.54 - 84px; height: 74px; HorizontalLayout { spacing: 4px; for asset in root.work-assets: ChoiceRow { width: 250px; height: 32px; label: (asset.selected ? asset.origin == "manual" ? "[Manual] " : "[Direct] " : "") + asset.label; selected: asset.selected; label-font-size: root.caption-font-size; toggled => { root.work-asset-toggled(asset.id, !asset.selected); } } } }
        Text { x: parent.width * 0.46 + 42px; y: 612px; width: parent.width * 0.54 - 210px; text: root.work-health-message; color: root.work-health-has-warnings ? #a34f32 : #39705d; font-size: root.caption-font-size; font-weight: 700; overflow: elide; accessible-role: text; accessible-label: self.text; }
        if root.work-health-action > 0: Button { x: parent.width - 168px; y: 604px; width: 126px; height: 26px; text: root.work-health-action-label; clicked => { if root.work-health-action == 3 { owner-edit.focus(); } else if root.work-health-action == 4 { due-edit.focus(); } else { root.work-health-action-requested(root.work-health-action); } } }
        Text { x: parent.width * 0.46 + 42px; y: 636px; width: parent.width - 560px; text: root.work-impact-total == 0 ? "No inferred neighbors" : root.work-impacts-capped ? "Showing " + root.work-impact-shown + " of " + root.work-impact-total + " potential impacts · " + root.work-impact-domains + " domains · " + root.work-impact-certificates + " certificates · " + root.work-impact-websites + " websites · " + root.work-impact-services + " services · " + root.work-impact-servers + " servers" : "Potential impact: " + root.work-impact-total + " · " + root.work-impact-domains + " domains · " + root.work-impact-certificates + " certificates · " + root.work-impact-websites + " websites · " + root.work-impact-services + " services · " + root.work-impact-servers + " servers"; color: root.work-impact-total == 0 ? #68736e : #80501d; font-size: root.caption-font-size; font-weight: 700; overflow: elide; }
        if root.work-impact-ignored > 0: Button { x: parent.width - 154px; y: 632px; width: 112px; height: 24px; text: "Reset ignored " + root.work-impact-ignored; clicked => { root.work-impact-exclusions-reset(); } }
        SectionLabel { x: parent.width * 0.46 + 42px; y: 666px; text: root.work-impacts.length == 0 ? "No inferred neighbors" : root.work-impacts-capped ? "POTENTIAL IMPACT · SHOWING UP TO 50 · REVIEW BEFORE READY" : "POTENTIAL IMPACT · REVIEW BEFORE READY"; color: root.work-impacts.length == 0 ? #68736e : #80501d; token-size: root.caption-font-size; }
        Button { x: parent.width - 286px; y: 660px; width: 112px; height: 26px; text: root.work-impact-depth == 1 ? "Depth 1" : "Depth 2"; clicked => { root.work-impact-depth = root.work-impact-depth == 1 ? 2 : 1; root.work-impact-depth-changed(root.work-impact-depth); } }
        Button { x: parent.width - 410px; y: 660px; width: 112px; height: 26px; text: root.work-impact-filter-index == 0 ? "All types" : root.work-impact-filter-index == 1 ? "Domains" : root.work-impact-filter-index == 2 ? "Certificates" : root.work-impact-filter-index == 3 ? "Websites" : root.work-impact-filter-index == 4 ? "Services" : "Servers"; clicked => { root.work-impact-filter-index = root.work-impact-filter-index == 5 ? 0 : root.work-impact-filter-index + 1; root.work-impact-filter-changed(root.work-impact-filter-index); } }
        if root.work-impacts.length > 0: Button { x: parent.width - 154px; y: 660px; width: 112px; height: 26px; text: root.work-impacts-capped ? "Add shown" : "Add all"; clicked => { root.work-all-impacts-promoted(root.work-impact-depth, root.work-impact-filter-index); } }
        ScrollView { x: parent.width * 0.46 + 42px; y: 684px; width: parent.width * 0.54 - 84px; height: 48px; HorizontalLayout { spacing: 2px; for impact in root.work-impacts: Rectangle { visible: root.work-impact-filter-index == 0 || (root.work-impact-filter-index == 1 && impact.category == "Domain") || (root.work-impact-filter-index == 2 && impact.category == "Certificate") || (root.work-impact-filter-index == 3 && impact.category == "Website") || (root.work-impact-filter-index == 4 && impact.category == "Service") || (root.work-impact-filter-index == 5 && impact.category == "Server"); width: 390px; height: 40px; background: #fff6e7; border-width: 1px; border-color: #e8c98e; Text { x: 8px; y: 2px; width: 72px; height: 18px; text: impact.category; color: #76501d; font-size: root.caption-font-size; font-weight: 700; overflow: elide; } Text { x: 82px; y: 2px; width: parent.width - 212px; height: 18px; text: impact.label; color: #6a4d22; font-size: root.caption-font-size; overflow: elide; } Text { x: 82px; y: 20px; width: parent.width - 212px; height: 16px; text: impact.reason; color: #78551f; font-size: root.caption-font-size; overflow: elide; } Button { x: parent.width - 122px; y: 6px; width: 54px; height: 28px; text: "Ignore"; clicked => { root.work-impact-excluded(impact.id); } } Button { x: parent.width - 62px; y: 6px; width: 54px; height: 28px; text: "Add"; clicked => { root.work-impact-promoted(impact.id); } } } } }
        }
        }
    }

    appearance-popup := PopupWindow {
        x: root.width - 540px; y: 64px; width: 512px; height: min(560px, root.height - 84px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: UiColors.surface; border-width: 1px; border-color: UiColors.action-border; border-radius: 8px;
            PanelTitle { x: 20px; y: 18px; text: "Appearance"; token-size: 20px; }
            Button { x: parent.width - 88px; y: 12px; width: 72px; height: 36px; text: "Close"; accessible-label: "Close appearance"; clicked => { appearance-popup.close(); appearance-trigger.focus(); } }
            Text { x: 20px; y: 58px; width: parent.width - 40px; height: 34px; text: "Preview right here. Your current workspace changes too."; color: UiColors.muted; font-size: 13px; wrap: word-wrap; }
            ScrollView {
                x: 20px; y: 100px; width: parent.width - 40px; height: parent.height - 200px;
                content-width: self.width; content-height: 300px;
                AppearanceControls {
                    x: 0; y: 0; width: parent.width; height: 300px;
                    theme-index <=> root.theme-index; font-size-step <=> root.font-size-step; table-density <=> root.table-density;
                    edited => { root.appearance-dirty = true; root.appearance-status = ""; root.appearance-error = false; }
                }
            }
            Text { x: 20px; y: parent.height - 92px; width: parent.width - 40px; height: 32px; text: root.appearance-error && root.appearance-status != "" ? root.appearance-status : root.appearance-dirty ? "Preview only · not saved yet." : root.appearance-status != "" ? root.appearance-status : "Save settings to keep these choices after restarting."; color: root.appearance-error ? #a33a32 : UiColors.muted; font-size: 12px; wrap: word-wrap; accessible-role: text; accessible-label: self.text; }
            Button { x: 20px; y: parent.height - 52px; width: parent.width - 40px; height: 36px; primary: true; text: "Save settings"; clicked => { root.save-settings(); } }
        }
    }

    if root.onboarding-open: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 660px) / 2; y: (parent.height - 500px) / 2; width: 660px; height: 500px; background: #f8faf6; border-radius: 8px;
            Text { x: 28px; y: 24px; text: "Start with one server"; color: #183c32; font-size: 22px; font-weight: 750; }
            Text { x: 28px; y: 58px; width: 520px; text: "ITGLA keeps the facts you need before a change, without turning your workspace into a CMDB."; color: #65776a; font-size: 11px; wrap: word-wrap; }
            Button { x: parent.width - 94px; y: 20px; width: 66px; height: 32px; text: "Close"; clicked => { root.onboarding-open = false; } }

            Rectangle { x: 28px; y: 112px; width: 604px; height: 92px; background: UiColors.surface; border-width: 1px; border-color: #d8e2d9; border-radius: 5px;
                Text { x: 16px; y: 14px; text: "1  Record what the machine is for"; color: #183c32; font-size: 13px; font-weight: 700; }
                Text { x: 16px; y: 42px; width: parent.width - 32px; text: "Add its IP address, ports, and useful tags. For an existing list, import Excel or CSV and map each source column."; color: #65776a; font-size: 10px; wrap: word-wrap; }
            }
            Rectangle { x: 28px; y: 216px; width: 604px; height: 92px; background: UiColors.surface; border-width: 1px; border-color: #d8e2d9; border-radius: 5px;
                Text { x: 16px; y: 14px; text: "2  Add structure only when it helps"; color: #183c32; font-size: 13px; font-weight: 700; }
                Text { x: 16px; y: 42px; width: parent.width - 32px; text: "Use tags for quick grouping. Add columns such as Project, Cloud Provider, OS, Environment, or Owner when you need consistent facts."; color: #65776a; font-size: 10px; wrap: word-wrap; }
            }
            Rectangle { x: 28px; y: 320px; width: 604px; height: 92px; background: UiColors.surface; border-width: 1px; border-color: #d8e2d9; border-radius: 5px;
                Text { x: 16px; y: 14px; text: "3  Keep sites beside infrastructure"; color: #183c32; font-size: 13px; font-weight: 700; }
                Text { x: 16px; y: 42px; width: parent.width - 32px; text: "Use Sites for URLs, environments, status, purpose, and tags. Search or copy any field when you need it."; color: #65776a; font-size: 10px; wrap: word-wrap; }
            }
            Button { x: 28px; y: 436px; width: 164px; height: 38px; text: "Add first server"; clicked => { root.active-tab = 0; root.onboarding-open = false; } }
            Button { x: 204px; y: 436px; width: 164px; height: 38px; text: "Import a table"; clicked => { root.active-tab = 0; root.importing-sites = false; root.onboarding-open = false; root.import-error = ""; root.import-dialog-open = true; } }
            Text { x: 388px; y: 446px; width: 244px; text: "You can reopen this from Guide."; color: #68736e; font-size: root.caption-font-size; horizontal-alignment: right; }
        }
    }

    if root.checklist-dialog-open: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 560px) / 2; y: (parent.height - 500px) / 2; width: 560px; height: 500px; background: #f8faf6; border-radius: 8px;
            Text { x: 24px; y: 20px; text: "Work checklist"; color: #183c32; font-size: 20px; font-weight: 750; }
            Button { x: parent.width - 94px; y: 16px; width: 70px; height: 30px; text: "Close"; clicked => { root.checklist-dialog-open = false; } }
            Text { x: 24px; y: 54px; width: parent.width - 48px; text: "Keep the execution steps visible and mark each one complete."; color: #5f7063; font-size: 10px; }
            ScrollView { x: 24px; y: 84px; width: parent.width - 48px; height: 322px; VerticalLayout { spacing: 4px; for item in root.checklist-items: Rectangle { height: 42px; background: UiColors.surface; border-width: 1px; border-color: #dce2dc; border-radius: 4px; Button { x: 6px; y: 6px; width: 34px; height: 30px; text: item.completed ? "✓" : "○"; clicked => { root.checklist-toggled(item.id, !item.completed); } } Text { x: 48px; y: 0; width: parent.width - 210px; height: parent.height; text: item.title; color: item.completed ? #7b8981 : #25342d; font-size: root.small-font-size; vertical-alignment: center; overflow: elide; } Button { x: parent.width - 154px; y: 6px; width: 34px; height: 30px; text: "↑"; clicked => { root.checklist-moved(item.id, -1); } } Button { x: parent.width - 116px; y: 6px; width: 34px; height: 30px; text: "↓"; clicked => { root.checklist-moved(item.id, 1); } } Button { x: parent.width - 78px; y: 6px; width: 70px; height: 30px; text: "Delete"; clicked => { root.checklist-deleted(item.id); } } } } }
            if root.checklist-items.length == 0: Text { x: 40px; y: 130px; width: parent.width - 80px; text: "No checklist items. Add the first execution step below."; color: #7b8981; font-size: root.small-font-size; horizontal-alignment: center; }
            LineEdit { x: 24px; y: 426px; width: parent.width - 142px; height: 38px; placeholder-text: "Add a verification or execution step"; text <=> root.checklist-input; }
            Button { x: parent.width - 108px; y: 426px; width: 84px; height: 38px; text: "Add"; clicked => { root.checklist-added(root.selected-work-id, root.checklist-input); } }
        }
    }

    if root.hide-target-id != 0: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 210px) / 2; width: 380px; height: 210px; background: UiColors.surface; border-radius: 8px; border-width: 1px; border-color: #b6c8bb;
            drop-shadow-blur: 24px; drop-shadow-color: #102b3340; drop-shadow-offset-y: 8px;
            Text { x: 24px; y: 24px; text: "Hide this server?"; color: #17201d; font-size: 18px; font-weight: 700; }
            Text { x: 24px; y: 64px; width: 332px; text: "Move this server out of your active list. You can restore it from Hidden servers at any time."; color: #46534e; font-size: root.small-font-size; wrap: word-wrap; }
            Button { x: 172px; y: 146px; width: 84px; height: 36px; text: "Cancel"; clicked => { root.hide-target-id = 0; } }
            Button { x: 268px; y: 146px; width: 88px; height: 36px; text: "Hide"; primary: true; clicked => { root.hide-server(root.hide-target-id); } }
        }
    }

    if root.hide-site-target-id != 0: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 210px) / 2; width: 380px; height: 210px; background: UiColors.surface; border-radius: 8px; border-width: 1px; border-color: #b6c8bb;
            drop-shadow-blur: 24px; drop-shadow-color: #102b3340; drop-shadow-offset-y: 8px;
            Text { x: 24px; y: 24px; text: "Hide this site?"; color: #17201d; font-size: 18px; font-weight: 700; }
            Text { x: 24px; y: 64px; width: 332px; text: "Move this site out of your active list. You can restore it from Hidden sites at any time."; color: #46534e; font-size: root.small-font-size; wrap: word-wrap; }
            Button { x: 172px; y: 146px; width: 84px; height: 36px; text: "Cancel"; clicked => { root.hide-site-target-id = 0; } }
            Button { x: 268px; y: 146px; width: 88px; height: 36px; text: "Hide"; primary: true; clicked => { root.hide-site(root.hide-site-target-id); } }
        }
    }

    if root.copy-notice != "": Rectangle {
        x: (parent.width - 112px) / 2; y: parent.height - 54px; width: 112px; height: 34px; background: #173f37; border-radius: 4px;
        Text { width: parent.width; height: parent.height; text: root.copy-notice; color: #ffffff; font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
    }

    if root.import-dialog-open: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 760px) / 2; y: (parent.height - 590px) / 2; width: 760px; height: 590px; background: UiColors.surface; border-radius: 6px;
            Text { x: 24px; y: 20px; text: root.importing-sites ? "Import sites" : "Import servers"; color: #17201d; font-size: 19px; font-weight: 700; }
            HelperText { x: 24px; y: 49px; width: 540px; height: 28px; text: root.importing-sites ? "Name and URL are required. Map source columns automatically or choose each destination." : "IP Address and Ports are required. Optional data can become tags or custom columns."; token-size: root.caption-font-size; }
            Button { x: 578px; y: 18px; width: 158px; height: 32px; text: "Save CSV template"; clicked => { root.save-import-template(); } }
            LineEdit { x: 24px; y: 78px; width: 474px; height: 36px; placeholder-text: "Choose a table or enter its full path"; text <=> root.import-file-path; }
            Button { x: 510px; y: 78px; width: 102px; height: 36px; text: "Browse"; clicked => { root.choose-import-file(); } }
            Button { x: 624px; y: 78px; width: 112px; height: 36px; text: "Load file"; clicked => { root.load-import(root.import-file-path); } }
            FieldLabel { x: 24px; y: 124px; text: "Defaults for empty or missing columns"; token-size: root.caption-font-size; }
            if root.importing-sites: LineEdit { x: 24px; y: 142px; width: 210px; height: 32px; placeholder-text: "Default environment"; text <=> root.import-default-tags; }
            if root.importing-sites: LineEdit { x: 244px; y: 142px; width: 210px; height: 32px; placeholder-text: "Default status"; text <=> root.import-default-ip-address; }
            if root.importing-sites: LineEdit { x: 464px; y: 142px; width: 140px; height: 32px; placeholder-text: "Default tags"; text <=> root.import-default-ports; }
            if !root.importing-sites: LineEdit { x: 24px; y: 142px; width: 210px; height: 32px; placeholder-text: "Default name (or uses IP)"; text <=> root.import-default-name; }
            if !root.importing-sites: LineEdit { x: 244px; y: 142px; width: 210px; height: 32px; placeholder-text: "Default IP address"; text <=> root.import-default-ip-address; }
            if !root.importing-sites: LineEdit { x: 464px; y: 142px; width: 140px; height: 32px; placeholder-text: "Default ports"; text <=> root.import-default-ports; }
            if !root.importing-sites: LineEdit { x: 24px; y: 182px; width: 210px; height: 32px; placeholder-text: "Default environment"; text <=> root.import-default-environment; }
            if !root.importing-sites: LineEdit { x: 244px; y: 182px; width: 210px; height: 32px; placeholder-text: "Default status"; text <=> root.import-default-status; }
            if !root.importing-sites: LineEdit { x: 464px; y: 182px; width: 140px; height: 32px; placeholder-text: "Default tags"; text <=> root.import-default-tags; }
            Button { x: 614px; y: 142px; width: 122px; height: 32px; text: "Auto match"; enabled: root.import-ready; clicked => { root.auto-map-import(); } }
            Text { x: 24px; y: 224px; width: 712px; text: root.importing-sites ? "Site fields: Name, URL, Environment, Status, Purpose, and Tags. Empty environment/status values use the defaults above." : "Server fields: Name, IP Address, Ports, Environment, Status, Purpose, and Tags. Missing names use the IP address."; color: #68736e; font-size: root.tiny-font-size; wrap: word-wrap; }
            Text { x: 24px; y: 252px; text: root.import-ready ? root.import-row-count + " rows ready · auto-matched where possible" : "Load a file to configure column mapping"; color: #46534e; font-size: root.small-font-size; font-weight: 600; }
            if root.import-ready: Rectangle {
                x: 24px; y: 276px; width: 712px; height: 208px; background: UiColors.surface; border-width: 1px; border-color: #dce3e0;
                ScrollView {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    VerticalLayout {
                        spacing: 0px;
                        for column in root.import-columns: ImportMappingRow { column: column; mapping-options: root.import-mapping-options; label-font-size: root.small-font-size; sample-font-size: root.tiny-font-size; mapping-changed(source-index, mapping-index) => { root.import-mapping-changed(source-index, mapping-index); } }
                    }
                }
            }
            if root.import-error != "": Text { x: 24px; y: 498px; width: 530px; text: root.import-error; color: #a33a32; font-size: 10px; wrap: word-wrap; }
            Button { x: 532px; y: 532px; width: 94px; height: 36px; text: "Cancel"; clicked => { root.import-dialog-open = false; } }
            Button { x: 638px; y: 532px; width: 98px; height: 36px; text: "Import"; enabled: root.import-ready; clicked => { root.confirm-import(); } }
        }
    }

    if root.editing-cell-column >= 0: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000066;
        Rectangle {
            x: (parent.width - 480px) / 2; y: (parent.height - 190px) / 2; width: 480px; height: 190px; background: UiColors.surface; border-radius: 6px;
            Text { x: 24px; y: 22px; text: "Edit cell"; color: #17201d; font-size: 18px; font-weight: 700; }
            LineEdit { x: 24px; y: 64px; width: 432px; height: 40px; text <=> root.editing-cell-value; }
            Button { x: 250px; y: 128px; width: 96px; height: 36px; text: "Cancel"; clicked => { root.editing-cell-column = -1; } }
            Button { x: 360px; y: 128px; width: 96px; height: 36px; text: "Save"; primary: true; clicked => { if root.editing-cell-is-site { root.save-site-cell-edit(root.editing-cell-id, root.editing-cell-column, root.editing-cell-value); } else { root.save-cell-edit(root.editing-cell-id, root.editing-cell-column, root.editing-cell-value); } } }
        }
    }
}
