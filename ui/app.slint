import { InventoryPanel, InventoryForm, InventoryRow, InventoryChoice } from "inventory.slint";
import { CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Button, UiColors } from "controls.slint";
import { AppearanceControls } from "appearance.slint";

export struct ServerRow { id: int, name: string, ip-address: string, ports: string, environment: string, status: string, purpose: string, tags: string, custom-values: [string] }
export struct SiteRow { id: int, name: string, url: string, environment: string, status: string, purpose: string, tags: string }
export struct ProjectRow { name: string, description: string, start-at: string, priority: string, launch-at: string }
export struct OperationRow { name: string, publish-at: string, media: string, channel: string }
export struct WorkRow { id: int, title: string, kind: string, status: string, priority: string, owner: string, due-at: string, due-state: string, checklist: string, scope: string }
export struct WorkProjectChoice { id: int, name: string, selected: bool }
export struct WorkServerChoice { id: int, label: string, selected: bool }
export struct WorkAssetChoice { id: int, label: string, selected: bool, origin: string }
export struct WorkImpactChoice { id: int, label: string, category: string, reason: string }
export struct ChecklistRow { id: int, title: string, completed: bool }
export struct ImportColumnRow { index: int, source-name: string, sample: string, mapping-index: int }

component PageHeader inherits Text {
    in property <length> token-size: 24px;
    color: #183c32;
    font-size: root.token-size;
    font-weight: 750;
}

component PanelTitle inherits Text {
    in property <length> token-size: 17px;
    color: #183c32;
    font-size: root.token-size;
    font-weight: 750;
}

component SectionLabel inherits Text {
    in property <length> token-size: 11px;
    color: #5f7063;
    font-size: root.token-size;
    font-weight: 700;
    letter-spacing: 1px;
}

component FieldLabel inherits Text {
    in property <length> token-size: 11px;
    color: #4e6257;
    font-size: root.token-size;
    font-weight: 700;
}

component HelperText inherits Text {
    in property <length> token-size: 12px;
    color: #5c6c64;
    font-size: root.token-size;
    wrap: word-wrap;
}

component NavigationTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <length> label-font-size: 13px;
    callback activated;
    background: root.selected ? #183c32 : tab-touch.has-hover ? #edf4eb : transparent;
    border-radius: 4px;
    border-width: tab-focus.has-focus ? 2px : root.selected ? 0px : 1px;
    border-color: tab-focus.has-focus ? #0f7665 : #aebfb1;
    forward-focus: tab-focus;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    Text { width: parent.width; height: parent.height; text: root.label; color: root.selected ? #ffffff : #183c32; font-size: root.label-font-size; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
    tab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
    tab-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
}

component ChoiceRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <length> label-font-size: 12px;
    callback toggled;
    background: root.selected ? #dceee8 : choice-touch.has-hover ? #eef4ed : transparent;
    border-radius: 4px;
    border-width: choice-focus.has-focus ? 2px : 0px;
    border-color: #0f7665;
    forward-focus: choice-focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.toggled(); }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: (root.selected ? "✓ " : "□ ") + root.label; color: #30463c; font-size: root.label-font-size; vertical-alignment: center; overflow: elide; }
    choice-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    choice-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

component DataCell inherits Rectangle {
    in property <int> server-id;
    in property <int> column-index;
    in property <string> value;
    in property <string> copy-label;
    in property <length> cell-font-size: 11px;
    in property <length> hover-font-size: 15px;
    in property <bool> show-tooltip: true;
    callback copy(string, string);
    callback edit(int, int, string);
    background: cell-touch.has-hover ? #e7f1dc : transparent;
    border-width: cell-focus.has-focus ? 2px : 0px;
    border-color: #0f7665;
    forward-focus: cell-focus;
    accessible-role: button;
    accessible-label: root.copy-label + ": " + (root.value == "" ? "empty" : root.value);
    accessible-description: "Press Space to copy. Press Enter to edit.";
    accessible-action-default => { root.copy(root.value, root.copy-label); }
    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #e1e7df; }
    Text { x: 10px; y: 0; width: parent.width - 38px; height: parent.height; text: root.value; color: #25342d; font-size: root.cell-font-size; vertical-alignment: center; overflow: elide; }
    if root.show-tooltip && measurement.preferred-width > root.width - 38px: Tooltip {
        Rectangle {
            width: min(240px, measurement.preferred-width + 20px); height: 36px;
            background: UiColors.surface; border-width: 1px; border-color: #9db89b; border-radius: 5px;
            Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.value; color: #183c32; font-size: root.cell-font-size; vertical-alignment: center; overflow: elide; }
        }
    }
    measurement := Text { visible: false; text: root.value; font-size: root.cell-font-size; }
    Text { x: parent.width - 28px; y: 0; width: 18px; height: parent.height; text: "⧉"; color: #6f8e55; font-size: 15px; vertical-alignment: center; horizontal-alignment: center; }
    cell-touch := TouchArea { clicked => { root.copy(root.value, root.copy-label); } double-clicked => { root.edit(root.server-id, root.column-index, root.value); } }
    cell-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space {
                root.copy(root.value, root.copy-label);
                return accept;
            }
            if event.text == Key.Return {
                root.edit(root.server-id, root.column-index, root.value);
                return accept;
            }
            return reject;
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> title;
    in property <length> header-font-size: 10px;
    in property <int> ascending-mode: -1;
    in property <int> descending-mode: -1;
    in property <int> current-mode: -1;
    property <bool> sorted: root.current-mode == root.ascending-mode || root.current-mode == root.descending-mode;
    callback sort(int);
    callback resize(length);
    background: sort-touch.pressed ? #c4ddcf : sort-touch.has-hover ? #d7e6d9 : root.sorted ? #dceee8 : #e7ede5;
    border-width: header-focus.has-focus ? 2px : 0px;
    border-color: #0f7665;
    forward-focus: header-focus;
    accessible-role: button;
    accessible-label: root.title + (root.current-mode == root.ascending-mode ? ", sorted ascending" : root.current-mode == root.descending-mode ? ", sorted descending" : ", not sorted");
    accessible-description: root.ascending-mode >= 0 ? "Activate to change sort direction. Use Fit columns to resize without a pointer." : "Table actions column";
    accessible-enabled: root.ascending-mode >= 0;
    accessible-action-default => { if root.ascending-mode >= 0 { root.sort(root.current-mode == root.ascending-mode ? root.descending-mode : root.ascending-mode); } }
    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #d3ddd4; }
    Text { x: 10px; width: parent.width - (root.ascending-mode >= 0 ? 38px : 16px); height: parent.height; text: root.title; color: root.sorted ? #0f5f50 : #465b4d; font-size: root.header-font-size; font-weight: 700; vertical-alignment: center; overflow: elide; }
    if root.ascending-mode >= 0: Text { x: parent.width - 34px; width: 20px; height: parent.height; text: root.current-mode == root.ascending-mode ? "↑" : root.current-mode == root.descending-mode ? "↓" : "↕"; color: root.sorted ? #0f5f50 : #65776a; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
    sort-touch := TouchArea {
        width: parent.width - 14px; enabled: root.ascending-mode >= 0; mouse-cursor: pointer;
        clicked => { root.sort(root.current-mode == root.ascending-mode ? root.descending-mode : root.ascending-mode); }
        Tooltip { text: root.current-mode == root.ascending-mode ? @markdown("Ascending · Click for descending") : root.current-mode == root.descending-mode ? @markdown("Descending · Click for ascending") : @markdown("Click to sort ascending · Numbers sort by value"); }
    }
    header-focus := FocusScope {
        width: 0px; enabled: root.ascending-mode >= 0;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.sort(root.current-mode == root.ascending-mode ? root.descending-mode : root.ascending-mode);
                return accept;
            }
            return reject;
        }
    }
    if root.ascending-mode >= 0: Rectangle {
        x: parent.width - 14px; width: 14px; height: parent.height;
        background: resize-touch.has-hover || resize-touch.pressed ? #c4ddcf : transparent;
        Rectangle { x: 11px; y: 6px; width: 2px; height: parent.height - 12px; background: resize-touch.has-hover || resize-touch.pressed ? #0f6b59 : #afc2b2; }
        resize-touch := TouchArea {
            mouse-cursor: ew-resize;
            moved => { if self.pressed { root.resize(root.width + self.mouse-x - self.pressed-x); } }
        }
    }
}

component ServerTableRow inherits Rectangle {
    in property <ServerRow> item;
    in property <[string]> custom-headers;
    in property <length> table-width;
    in property <length> data-width;
    in property <length> cell-font-size: 11px;
    in property <length> hover-font-size: 15px;
    in property <[length]> column-widths;
    in property <bool> hidden;
    in property <bool> show-tooltips: true;
    in property <length> row-height: 42px;
    callback edit; callback hide; callback restore; callback copy(string, string); callback edit-cell(int, int, string);
    width: root.table-width; height: root.row-height; background: UiColors.surface;
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #e1e7df; }
    HorizontalLayout {
        spacing: 0px;
        DataCell { width: root.column-widths[0]; server-id: root.item.id; column-index: 0; value: root.item.name; copy-label: "Name"; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; show-tooltip: root.show-tooltips; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[1]; server-id: root.item.id; column-index: 1; value: root.item.ip-address; copy-label: "IP address"; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[2]; server-id: root.item.id; column-index: 2; value: root.item.ports; copy-label: "Ports"; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[3]; server-id: root.item.id; column-index: 3; value: root.item.environment; copy-label: "Environment"; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[4]; server-id: root.item.id; column-index: 4; value: root.item.status; copy-label: "Status"; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[5]; server-id: root.item.id; column-index: 5; value: root.item.purpose; copy-label: "Purpose"; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[6]; server-id: root.item.id; column-index: 6; value: root.item.tags; copy-label: "Tags"; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        for value[index] in root.item.custom-values: DataCell { width: root.column-widths[7 + index]; server-id: root.item.id; column-index: 7 + index; value: value; copy-label: root.custom-headers[index]; cell-font-size: root.cell-font-size; hover-font-size: root.hover-font-size; copy(cell-value, label) => { root.copy(cell-value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        Rectangle {
            width: 116px; background: transparent;
            if !root.hidden: Button { x: 5px; y: 6px; width: 44px; height: 28px; text: "Edit"; clicked => { root.edit(); } }
            if !root.hidden: Button { x: 53px; y: 6px; width: 58px; height: 28px; text: "Hide"; clicked => { root.hide(); } }
            if root.hidden: Button { x: 9px; y: 6px; width: 98px; height: 28px; text: "Restore"; clicked => { root.restore(); } }
        }
        Rectangle { width: root.table-width > root.data-width + 116px ? root.table-width - root.data-width - 116px : 0px; background: transparent; }
    }
}

component TableHeader inherits Rectangle {
    in property <[string]> custom-headers;
    in property <length> table-width;
    in property <length> data-width;
    in property <length> header-font-size: 10px;
    in property <[length]> column-widths;
    in property <int> sort-mode-index;
    callback sort(int);
    callback resize(int, length);
    width: root.table-width; height: 34px; background: #e7ede5; border-width: 1px; border-color: #d3ddd4;
    HorizontalLayout {
        spacing: 0px;
        HeaderCell { width: root.column-widths[0]; title: "NAME"; header-font-size: root.header-font-size; ascending-mode: 0; descending-mode: 1; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(0, value); } }
        HeaderCell { width: root.column-widths[1]; title: "IP ADDRESS"; header-font-size: root.header-font-size; ascending-mode: 2; descending-mode: 3; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(1, value); } }
        HeaderCell { width: root.column-widths[2]; title: "PORTS"; header-font-size: root.header-font-size; ascending-mode: 4; descending-mode: 5; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(2, value); } }
        HeaderCell { width: root.column-widths[3]; title: "ENVIRONMENT"; header-font-size: root.header-font-size; ascending-mode: 6; descending-mode: 7; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(3, value); } }
        HeaderCell { width: root.column-widths[4]; title: "STATUS"; header-font-size: root.header-font-size; ascending-mode: 8; descending-mode: 9; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(4, value); } }
        HeaderCell { width: root.column-widths[5]; title: "PURPOSE"; header-font-size: root.header-font-size; ascending-mode: 10; descending-mode: 11; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(5, value); } }
        HeaderCell { width: root.column-widths[6]; title: "TAGS"; header-font-size: root.header-font-size; ascending-mode: 12; descending-mode: 13; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(6, value); } }
        for header[index] in root.custom-headers: HeaderCell { width: root.column-widths[7 + index]; title: header; header-font-size: root.header-font-size; ascending-mode: 14 + index * 2; descending-mode: 15 + index * 2; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(7 + index, value); } }
        HeaderCell { width: 116px; title: "ACTIONS"; header-font-size: root.header-font-size; }
        Rectangle { width: root.table-width > root.data-width + 116px ? root.table-width - root.data-width - 116px : 0px; background: #e7ede5; }
    }
}

component SiteTableHeader inherits Rectangle {
    in property <[length]> column-widths;
    in property <length> table-width;
    in property <int> sort-mode-index;
    in property <length> header-font-size: 10px;
    callback sort(int);
    callback resize(int, length);
    width: root.table-width; height: 34px; background: #e7ede5; border-width: 1px; border-color: #d3ddd4;
    HorizontalLayout {
        spacing: 0px;
        HeaderCell { width: root.column-widths[0]; title: "NAME"; header-font-size: root.header-font-size; ascending-mode: 0; descending-mode: 1; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(0, value); } }
        HeaderCell { width: root.column-widths[1]; title: "URL"; header-font-size: root.header-font-size; ascending-mode: 2; descending-mode: 3; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(1, value); } }
        HeaderCell { width: root.column-widths[2]; title: "ENVIRONMENT"; header-font-size: root.header-font-size; ascending-mode: 4; descending-mode: 5; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(2, value); } }
        HeaderCell { width: root.column-widths[3]; title: "STATUS"; header-font-size: root.header-font-size; ascending-mode: 6; descending-mode: 7; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(3, value); } }
        HeaderCell { width: root.column-widths[4]; title: "PURPOSE"; header-font-size: root.header-font-size; ascending-mode: 8; descending-mode: 9; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(4, value); } }
        HeaderCell { width: root.column-widths[5]; title: "TAGS"; header-font-size: root.header-font-size; ascending-mode: 10; descending-mode: 11; current-mode: root.sort-mode-index; sort(mode) => { root.sort(mode); } resize(value) => { root.resize(5, value); } }
        HeaderCell { width: 116px; title: "ACTIONS"; header-font-size: root.header-font-size; }
    }
}

component SiteTableRow inherits Rectangle {
    in property <SiteRow> item;
    in property <[length]> column-widths;
    in property <length> table-width;
    in property <length> cell-font-size: 11px;
    in property <bool> hidden;
    in property <bool> show-tooltips: true;
    in property <length> row-height: 42px;
    callback edit; callback hide; callback restore; callback copy(string, string); callback edit-cell(int, int, string);
    width: root.table-width; height: root.row-height; background: UiColors.surface;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e1e7df; }
    HorizontalLayout {
        spacing: 0px;
        DataCell { width: root.column-widths[0]; server-id: root.item.id; column-index: 0; value: root.item.name; copy-label: "Name"; cell-font-size: root.cell-font-size; show-tooltip: root.show-tooltips; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[1]; server-id: root.item.id; column-index: 1; value: root.item.url; copy-label: "URL"; cell-font-size: root.cell-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[2]; server-id: root.item.id; column-index: 2; value: root.item.environment; copy-label: "Environment"; cell-font-size: root.cell-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[3]; server-id: root.item.id; column-index: 3; value: root.item.status; copy-label: "Status"; cell-font-size: root.cell-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[4]; server-id: root.item.id; column-index: 4; value: root.item.purpose; copy-label: "Purpose"; cell-font-size: root.cell-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        DataCell { width: root.column-widths[5]; server-id: root.item.id; column-index: 5; value: root.item.tags; copy-label: "Tags"; cell-font-size: root.cell-font-size; copy(value, label) => { root.copy(value, label); } edit(id, column, value) => { root.edit-cell(id, column, value); } }
        Rectangle {
            width: 116px;
            if !root.hidden: Button { x: 5px; y: 6px; width: 44px; height: 28px; text: "Edit"; clicked => { root.edit(); } }
            if !root.hidden: Button { x: 53px; y: 6px; width: 58px; height: 28px; text: "Hide"; clicked => { root.hide(); } }
            if root.hidden: Button { x: 9px; y: 6px; width: 98px; height: 28px; text: "Restore"; clicked => { root.restore(); } }
        }
    }
}

component TagChoice inherits Rectangle {
    in property <string> label; in property <bool> selected; in property <length> label-font-size: 12px; callback chosen;
    height: 34px; background: root.selected ? #dceee8 : tag-touch.has-hover ? #eef4ed : transparent; border-radius: 4px;
    border-width: tag-focus.has-focus ? 2px : 0px; border-color: #0f7665;
    forward-focus: tag-focus;
    accessible-role: button;
    accessible-label: "Filter by " + root.label;
    accessible-action-default => { root.chosen(); }
    Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.label; color: root.selected ? #0f5f50 : #44504b; font-size: root.label-font-size; font-weight: root.selected ? 700 : 500; vertical-alignment: center; overflow: elide; }
    tag-touch := TouchArea { mouse-cursor: pointer; clicked => { root.chosen(); } }
    tag-focus := FocusScope { width: 0px; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.chosen(); return accept; } return reject; } }
}

component ImportMappingRow inherits Rectangle {
    in property <ImportColumnRow> column;
    in property <[string]> mapping-options;
    in property <length> label-font-size: 11px;
    in property <length> sample-font-size: 10px;
    callback mapping-changed(int, int);
    height: 62px; background: UiColors.surface;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e5e9e7; }
    Text { x: 8px; y: 8px; width: 210px; text: root.column.source-name; color: #26312d; font-size: root.label-font-size; font-weight: 700; overflow: elide; }
    Text { x: 8px; y: 31px; width: 300px; text: root.column.sample == "" ? "No sample value" : root.column.sample; color: #68736e; font-size: root.sample-font-size; overflow: elide; }
    mapping-box := ComboBox {
        x: parent.width - 250px; y: 13px; width: 242px; height: 36px;
        model: root.mapping-options; current-index: root.column.mapping-index;
        selected(value) => { root.mapping-changed(root.column.index, mapping-box.current-index); }
    }
}

component WorkListRow inherits Rectangle {
    in property <WorkRow> item;
    in property <length> title-font-size: 13px;
    in property <length> metadata-font-size: 11px;
    callback selected(int);
    callback quick-status(int, string);
    height: 82px; background: row-touch.has-hover ? #f5f9f3 : #ffffff;
    border-width: row-focus.has-focus ? 2px : 0px; border-color: #0f7665;
    forward-focus: row-focus;
    accessible-role: list-item;
    accessible-label: root.item.title + ", " + root.item.status + ", " + root.item.priority;
    accessible-description: "Activate to open work details.";
    accessible-action-default => { root.selected(root.item.id); }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e1e7df; }
    Text { x: 14px; y: 8px; width: parent.width - 170px; height: 24px; text: root.item.title; color: #183c32; font-size: root.title-font-size; font-weight: 700; overflow: elide; }
    Text { x: 14px; y: 36px; width: 180px; height: 20px; text: root.item.kind + "  ·  " + root.item.checklist; color: #627269; font-size: root.metadata-font-size; overflow: elide; }
    Text { x: parent.width - 226px; y: 8px; width: 116px; height: 20px; text: root.item.status; color: root.item.status == "Done" ? #526b59 : root.item.status == "Blocked" ? #a33a32 : #176b59; font-size: root.metadata-font-size; font-weight: 700; horizontal-alignment: right; }
    Button { x: parent.width - 102px; y: 5px; width: 92px; height: 28px; text: root.item.status == "In progress" ? "Done" : root.item.status == "Blocked" ? "Resume" : root.item.status == "Done" || root.item.status == "Cancelled" ? "Reopen" : "Start"; clicked => { root.quick-status(root.item.id, root.item.status == "In progress" ? "done" : root.item.status == "Blocked" ? "in_progress" : root.item.status == "Done" || root.item.status == "Cancelled" ? "planned" : "in_progress"); } }
    if root.item.status == "In progress" || root.item.status == "Ready": Button { x: parent.width - 102px; y: 39px; width: 92px; height: 28px; text: "Block"; clicked => { root.quick-status(root.item.id, "blocked"); } }
    Text { x: parent.width - 330px; y: 50px; width: 218px; height: 20px; text: root.item.priority + " · " + root.item.due-state + (root.item.due-at == "" ? "" : " " + root.item.due-at) + " · " + root.item.scope; color: root.item.due-state == "Overdue" ? #b13d35 : root.item.due-state == "Due today" || root.item.due-state == "Due soon" ? #8a571d : #627269; font-size: root.metadata-font-size; font-weight: root.item.due-state == "Overdue" || root.item.due-state == "Due today" ? 700 : 400; horizontal-alignment: right; overflow: elide; }
    row-touch := TouchArea { x: 0; y: 0; width: parent.width - 108px; height: parent.height; mouse-cursor: pointer; clicked => { root.selected(root.item.id); } }
    row-focus := FocusScope { width: 0px; key-pressed(event) => { if event.text == Key.Space || event.text == Key.Return { root.selected(root.item.id); return accept; } return reject; } }
}

export component AppWindow inherits Window {
    title: "ITGLA - IT Resource Workspace";
    icon: @image-url("../assets/itgla.png");
    preferred-width: 1240px; preferred-height: 800px; min-width: 1000px; min-height: 640px; background: root.theme-index == 2 ? #f3eee4 : root.theme-index == 3 ? #ffffff : root.theme-index == 1 ? #e8edf0 : #eef1eb;
    in property <[ServerRow]> servers;
    in property <[SiteRow]> sites;
    in property <[ProjectRow]> projects;
    in property <[OperationRow]> operations;
    in property <[WorkRow]> work-items;
    in property <[WorkProjectChoice]> work-projects;
    in property <[WorkServerChoice]> work-servers;
    in property <[WorkAssetChoice]> work-assets;
    in property <[WorkImpactChoice]> work-impacts;
    in property <[ChecklistRow]> checklist-items;
    in property <[string]> priority-options;
    in property <[string]> media-options;
    in property <[string]> available-tags;
    in property <[string]> environment-options: ["Production", "Staging", "Development", "Test", "Local"];
    in property <[string]> status-options: ["Active", "Maintenance", "Attention", "Offline", "Planned", "Retired"];
    in property <[string]> tag-suggestions;
    in property <[string]> custom-field-labels;
    in property <[string]> custom-headers;
    in property <int> custom-column-count;
    in property <int> server-count;
    in property <int> site-count;
    in property <int> hidden-site-count;
    in property <int> hidden-count;
    in-out property <bool> has-server-records: false;
    in-out property <string> active-tag;
    in-out property <int> sort-mode-index: 0;
    in-out property <bool> show-hidden: false;
    in-out property <bool> show-hidden-sites: false;
    in-out property <string> site-query;
    in-out property <int> site-sort-mode-index: 0;
    in-out property <int> editing-site-id: 0;
    in-out property <string> editing-site-name;
    in-out property <string> editing-site-url;
    in-out property <string> editing-site-environment: "Production";
    in-out property <string> editing-site-status: "Active";
    in-out property <string> editing-site-purpose;
    in-out property <string> editing-site-tags;
    in-out property <int> hide-site-target-id: 0;
    in-out property <int> editing-id: 0;
    in-out property <string> editing-name;
    in-out property <string> editing-tags;
    in-out property <string> editing-ip-address;
    in-out property <string> editing-ports;
    in-out property <string> editing-environment: "Production";
    in-out property <string> editing-status: "Active";
    in-out property <string> editing-purpose;
    in-out property <int> hide-target-id: 0;
    in-out property <string> status-message;
    in-out property <bool> status-is-error: false;
    in-out property <string> copy-notice;
    in-out property <int> active-tab: 0;
    in-out property <int> selected-work-id: 0;
    in-out property <string> work-title;
    in-out property <string> work-kind: "change";
    in-out property <string> work-status: "inbox";
    in-out property <int> work-kind-index: 0;
    in-out property <int> work-status-index: 0;
    in-out property <string> work-list-query;
    in-out property <int> work-list-kind-filter: 0;
    in-out property <int> work-list-status-filter: 0;
    in-out property <int> work-list-sort-mode: 0;
    in-out property <string> work-priority: "P2";
    in-out property <string> work-owner;
    in-out property <string> work-start-at;
    in-out property <string> work-due-at;
    in-out property <string> work-notes;
    in-out property <int> work-project-count: 0;
    in-out property <int> work-server-count: 0;
    in-out property <int> work-asset-count: 0;
    in-out property <int> work-impact-depth: 1;
    in-out property <bool> work-impacts-capped: false;
    in-out property <int> work-impact-total: 0;
    in-out property <int> work-impact-shown: 0;
    in-out property <int> work-impact-domains: 0;
    in-out property <int> work-impact-certificates: 0;
    in-out property <int> work-impact-websites: 0;
    in-out property <int> work-impact-services: 0;
    in-out property <int> work-impact-servers: 0;
    in-out property <int> work-impact-ignored: 0;
    in-out property <string> work-health-message;
    in-out property <bool> work-health-has-warnings: false;
    in-out property <int> work-health-action: 0;
    in-out property <string> work-health-action-label;
    in-out property <bool> checklist-dialog-open: false;
    in-out property <string> checklist-input;
    in-out property <int> work-impact-filter-index: 0;
    in-out property <string> priority-input;
    in-out property <string> media-input;
    in-out property <int> priority-index: 0;
    in-out property <int> media-index: 0;
    in-out property <bool> import-dialog-open: false;
    in-out property <string> import-file-path;
    in-out property <string> import-default-tags: "imported";
    in-out property <string> import-default-ip-address;
    in-out property <string> import-default-ports: "443";
    in-out property <string> import-default-name;
    in-out property <string> import-default-environment: "Production";
    in-out property <string> import-default-status: "Active";
    in-out property <string> import-default-purpose;
    in-out property <[ImportColumnRow]> import-columns;
    in-out property <[string]> import-mapping-options;
    in-out property <int> import-row-count;
    in-out property <bool> import-ready: false;
    in-out property <string> import-error;
    in-out property <bool> importing-sites: false;
    in-out property <int> font-size-step: 2;
    in-out property <int> theme-index: 0;
    in-out property <bool> appearance-dirty: false;
    in-out property <string> appearance-status;
    in-out property <bool> appearance-error: false;
    in-out property <int> table-density: 1;
    in-out property <bool> show-cell-tooltips: true;
    in-out property <bool> fit-columns-on-open: false;
    in-out property <int> import-duplicate-policy: 0;
    in-out property <int> backup-retention: 7;
    in-out property <bool> demo-mode: false;
    in-out property <string> settings-option-input;
    in-out property <string> settings-status-input;
    in-out property <string> settings-tag-input;
    in-out property <string> settings-field-input;
    in-out property <int> settings-field-type: 0;
    in-out property <[length]> column-widths: [160px, 140px, 110px, 130px, 110px, 220px, 170px];
    in-out property <length> table-data-width: 1040px;
    in-out property <length> server-table-scroll-x: 0px;
    in-out property <length> work-page-scroll-y: 0px;
    in-out property <int> work-view-reset-counter: 0;
    property <bool> work-view-reset-pending: false;
    in-out property <bool> onboarding-open: false;
    in-out property <int> editing-cell-column: -1;
    in-out property <int> editing-cell-id: 0;
    in-out property <string> editing-cell-value;
    in-out property <bool> editing-cell-is-site: false;
    property <length> caption-font-size: root.font-size-step == 0 ? 10px : root.font-size-step == 1 ? 11px : 12px;
    property <length> body-font-size: root.font-size-step == 0 ? 11px : root.font-size-step == 1 ? 12px : 13px;
    property <length> control-font-size: root.font-size-step == 0 ? 12px : root.font-size-step == 1 ? 13px : 14px;
    property <length> panel-title-font-size: root.font-size-step == 0 ? 16px : root.font-size-step == 1 ? 17px : 18px;
    property <length> page-title-font-size: root.font-size-step == 0 ? 22px : root.font-size-step == 1 ? 24px : 28px;
    property <length> tiny-font-size: root.caption-font-size;
    property <length> small-font-size: root.body-font-size;
    property <length> medium-font-size: root.control-font-size;
    property <length> large-font-size: root.page-title-font-size;
    property <length> hover-font-size: root.font-size-step == 0 ? 14px : root.font-size-step == 1 ? 15px : 18px;
    property <length> table-row-height: root.table-density == 0 ? 34px : root.table-density == 1 ? 42px : 50px;
    default-font-size: root.control-font-size;
    in-out property <length> table-width: 816px;
    in-out property <[length]> site-column-widths: [180px, 260px, 140px, 120px, 220px, 180px];
    in-out property <length> site-table-width: 1216px;
    in-out property <length> site-table-scroll-x: 0px;
    in-out property <InventoryForm> inventory-form;
    in-out property <[InventoryRow]> inventory-rows;
    in-out property <[InventoryChoice]> inventory-hosts;
    in-out property <[InventoryChoice]> inventory-targets;
    in-out property <[string]> inventory-target-labels;
    in-out property <[InventoryRow]> inventory-relations;
    in-out property <string> inventory-query;
    in-out property <string> inventory-filter-label: "All servers";
    in-out property <int> inventory-server-filter: 0;
    in-out property <bool> inventory-show-hidden: false;
    in-out property <bool> inventory-credentials-available: false;
    in-out property <string> inventory-username;
    in-out property <string> inventory-password;
    in-out property <bool> inventory-reveal: false;
    in-out property <bool> inventory-clear-credentials: false;
    in-out property <int> inventory-target-index: 0;
    in-out property <int> inventory-relation-kind: 0;
    in-out property <string> inventory-relation-notes;
    callback inventory-refresh();
    callback inventory-select(int);
    callback inventory-new(int);
    callback inventory-save();
    callback inventory-hide(int,bool);
    callback inventory-unlock();
    callback inventory-copy-secret(bool);
    callback inventory-relation-add();
    callback inventory-relation-remove(int);
    callback inventory-verify();
    callback inventory-export();
    callback open-server-inventory(int);
    Timer { interval: 30s; running: root.inventory-reveal; triggered => { root.inventory-reveal = false; } }
    callback search-changed(string);
    callback tag-selected(string);
    callback sort-selected(int);
    callback show-hidden-changed(bool);
    callback save-server(int, string, string, string, string, string, string, string);
    callback hide-server(int);
    callback restore-server(int);
    callback site-search-changed(string);
    callback site-sort-selected(int);
    callback show-hidden-sites-changed(bool);
    callback save-site(int, string, string, string, string, string, string);
    callback hide-site(int);
    callback restore-site(int);
    callback edit-site-cell(int, int, string);
    callback save-site-cell-edit(int, int, string);
    callback site-column-width-changed(int, length);
    callback auto-fit-site-columns;
    callback copy-value(string, string);
    callback choose-import-file;
    callback save-import-template;
    callback load-import(string);
    callback import-mapping-changed(int, int);
    callback auto-map-import;
    callback confirm-import;
    callback tab-selected(int);
    callback work-selected(int);
    callback save-work(int, string, string, string, string, string, string, string, string);
    callback new-work;
    callback archive-work(int);
    callback work-project-toggled(int, bool);
    callback work-server-toggled(int, bool);
    callback work-asset-toggled(int, bool);
    callback work-impact-promoted(int);
    callback work-impact-excluded(int);
    callback work-impact-exclusions-reset;
    callback work-all-impacts-promoted(int, int);
    callback work-impact-depth-changed(int);
    callback work-impact-filter-changed(int);
    callback work-health-action-requested(int);
    callback work-list-filter-changed(string, int, int, int);
    callback work-quick-status(int, string);
    callback checklist-toggled(int, bool);
    callback checklist-added(int, string);
    callback checklist-deleted(int);
    callback checklist-moved(int, int);
    callback font-size-changed(int);
    callback preferences-changed(int, int, int, bool, bool, int, int);
    callback save-settings;
    save-settings => {
        root.preferences-changed(root.theme-index, root.font-size-step, root.table-density, root.show-cell-tooltips, root.fit-columns-on-open, root.import-duplicate-policy, root.backup-retention);
        root.appearance-status = root.status-message;
        root.appearance-error = root.status-is-error;
        if !root.status-is-error { root.appearance-dirty = false; }
    }

    callback add-managed-option(string, string);
    callback add-managed-tag(string);
    callback add-custom-field(string, int);
    callback create-managed-backup;
    callback enter-demo;
    callback reset-demo;
    callback exit-demo;
    callback edit-cell(int, int, string);
    callback save-cell-edit(int, int, string);
    callback column-width-changed(int, length);
    callback auto-fit-columns;
    callback add-priority(string);
    callback remove-priority(int);
    callback add-media(string);
    callback remove-media(int);
    callback focus-navigation;
    focus-navigation => { servers-tab.focus(); }
    callback reset-work-view;
    reset-work-view => { root.work-page-scroll-y = 0px; root.work-view-reset-counter += 1; root.work-view-reset-pending = true; servers-tab.focus(); }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: 72px; background: root.theme-index == 1 ? #24313a : root.theme-index == 2 ? #51402d : root.theme-index == 3 ? #000000 : #183c32;
        Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #315b4d; }
        Text { x: 28px; y: 12px; text: "ITGLA"; color: #d7ee9d; font-size: 20px; font-weight: 800; letter-spacing: 1px; }
        Text { x: 29px; y: 40px; text: "FIELD ATLAS  /  LOCAL WORKSPACE"; color: #a9c7ad; font-size: root.caption-font-size; font-weight: 700; letter-spacing: 1px; }
        if root.demo-mode: Text { x: 260px; y: 22px; width: 154px; text: "DEMO WORKSPACE"; color: #fff2bb; font-size: root.caption-font-size; font-weight: 800; horizontal-alignment: center; }
        Text { x: parent.width - 590px; y: 22px; width: 114px; text: root.active-tab == 0 ? root.server-count + (root.server-count == 1 ? " SERVER" : " SERVERS") : root.active-tab == 1 ? root.site-count + (root.site-count == 1 ? " SITE" : " SITES") : root.active-tab == 4 ? "INVENTORY" : "SETTINGS"; color: #c8ddb0; font-size: root.caption-font-size; font-weight: 700; horizontal-alignment: right; }
        Button { x: parent.width - 468px; y: 18px; width: 76px; height: 36px; text: "Guide"; clicked => { root.onboarding-open = true; } }
        Button { x: parent.width - 386px; y: 18px; width: 92px; height: 36px; text: "Fit columns"; enabled: root.active-tab < 2; clicked => { if root.active-tab == 0 { root.auto-fit-columns(); root.server-table-scroll-x = 0px; } else if root.active-tab == 1 { root.auto-fit-site-columns(); root.site-table-scroll-x = 0px; } } }
        appearance-trigger := Button { x: parent.width - 286px; y: 18px; width: 114px; height: 36px; text: "Appearance"; clicked => { root.appearance-status = ""; root.appearance-error = false; appearance-popup.show(); } }
        Button { x: parent.width - 164px; y: 18px; width: 136px; height: 36px; text: "＋  Import table"; enabled: root.active-tab < 2; clicked => { root.import-error = ""; root.import-ready = false; root.importing-sites = root.active-tab == 1; root.import-default-tags = root.active-tab == 1 ? "production" : "imported"; root.import-default-ip-address = root.active-tab == 1 ? "Active" : ""; root.import-default-ports = root.active-tab == 1 ? "" : "443"; root.import-default-name = ""; root.import-default-environment = "Production"; root.import-default-status = "Active"; root.import-default-purpose = ""; root.import-dialog-open = true; } }
    }

    Rectangle {
        x: 28px; y: 78px; width: parent.width - 56px; height: 42px; background: #dfe8de; border-radius: 5px;
        servers-tab := NavigationTab { x: 4px; y: 4px; width: 112px; height: 34px; label: "Servers"; selected: root.active-tab == 0; label-font-size: root.control-font-size; activated => { root.tab-selected(0); } }
        sites-tab := NavigationTab { x: 120px; y: 4px; width: 112px; height: 34px; label: "Sites"; selected: root.active-tab == 1; label-font-size: root.control-font-size; activated => { root.tab-selected(1); } }
        NavigationTab { x: 236px; y: 4px; width: 176px; height: 34px; label: "Services & Domains"; selected: root.active-tab == 4; label-font-size: root.control-font-size; activated => { root.tab-selected(4); } }
        settings-tab := NavigationTab { x: 428px; y: 4px; width: 112px; height: 34px; label: "Settings"; selected: root.active-tab == 2; label-font-size: root.control-font-size; activated => { root.tab-selected(2); } }
    }

    if root.active-tab == 4: InventoryPanel {
        x: 28px; y: 138px; width: parent.width - 56px; height: parent.height - 162px;
        form <=> root.inventory-form; rows: root.inventory-rows; hosts <=> root.inventory-hosts;
        relations: root.inventory-relations; target-labels: root.inventory-target-labels;
        target-index <=> root.inventory-target-index; relation-kind <=> root.inventory-relation-kind;
        relation-notes <=> root.inventory-relation-notes; query <=> root.inventory-query;
        show-hidden <=> root.inventory-show-hidden; filter-label: root.inventory-filter-label;
        server-filtered: root.inventory-server-filter != 0;
        credentials-available: root.inventory-credentials-available;
        username <=> root.inventory-username; password <=> root.inventory-password;
        reveal <=> root.inventory-reveal; clear-credentials <=> root.inventory-clear-credentials;
        status: root.status-message; status-error: root.status-is-error;
        refresh => { root.inventory-refresh(); }
        new-record(kind) => { root.inventory-new(kind); }
        select-record(id) => { root.inventory-select(id); }
        save => { root.inventory-save(); }
        hide(id,hidden) => { root.inventory-hide(id,hidden); }
        unlock => { root.inventory-unlock(); }
        copy-secret(password) => { root.inventory-copy-secret(password); }
        copy(value,label) => { root.copy-value(value,label); }
        clear-filter => { root.inventory-server-filter = 0; root.inventory-refresh(); }
        add-relation => { root.inventory-relation-add(); }
        remove-relation(id) => { root.inventory-relation-remove(id); }
        verify => { root.inventory-verify(); }
        export => { root.inventory-export(); }
    }

    if root.active-tab == 0: Rectangle {
        x: 28px; y: 138px; width: parent.width - 412px; height: parent.height - 162px; background: transparent;
        Text { x: 0; y: 0; text: root.show-hidden ? "Hidden servers" : root.active-tag == "" ? "Servers" : "Servers tagged " + root.active-tag; color: #183c32; font-size: root.large-font-size; font-weight: 750; }
        Text { x: 0; y: 34px; text: "INDEX / INFRASTRUCTURE"; color: #5f7065; font-size: root.tiny-font-size; font-weight: 700; letter-spacing: 1px; }
        Button { x: parent.width - 132px; y: -4px; width: 132px; height: 32px; text: root.show-hidden ? "Back to active" : "Hidden (" + root.hidden-count + ")"; clicked => { root.show-hidden-changed(!root.show-hidden); } }
        LineEdit { x: 0; y: 56px; width: parent.width; height: 38px; placeholder-text: "⌕  Search every field"; edited(value) => { root.search-changed(value); } }
        Rectangle {
            x: 0; y: 108px; width: parent.width; height: parent.height - 108px; background: UiColors.surface; border-width: 1px; border-color: #d3ddd4;
            server-table-scroll := ScrollView {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                content-x <=> root.server-table-scroll-x;
                VerticalLayout {
                    width: root.table-width; spacing: 0px;
                    TableHeader { custom-headers: root.custom-headers; column-widths: root.column-widths; table-width: root.table-width; data-width: root.table-data-width; header-font-size: root.small-font-size; sort-mode-index: root.sort-mode-index; sort(mode) => { root.sort-selected(mode); } resize(index, value) => { root.column-width-changed(index, value); } }
                    for server in root.servers: ServerTableRow {
                        item: server; custom-headers: root.custom-headers; column-widths: root.column-widths; table-width: root.table-width; data-width: root.table-data-width; cell-font-size: root.small-font-size; hover-font-size: root.hover-font-size; hidden: root.show-hidden; show-tooltips: root.show-cell-tooltips; row-height: root.table-row-height;
                        edit => { root.editing-id = server.id; root.editing-name = server.name; root.editing-ip-address = server.ip-address; root.editing-ports = server.ports; root.editing-environment = server.environment; root.editing-status = server.status; root.editing-purpose = server.purpose; root.editing-tags = server.tags; root.status-message = ""; }
                        hide => { root.hide-target-id = server.id; }
