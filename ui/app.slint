                    Button { x: 408px; y: 78px; width: 174px; height: 34px; text: "Create backup now"; enabled: !root.demo-mode; clicked => { root.create-managed-backup(); } }
                    Rectangle { x: 20px; y: 132px; width: parent.width - 40px; height: 1px; background: #e2e7e5; }
                    Text { x: 20px; y: 148px; width: 480px; text: root.demo-mode ? "You are editing fictional local demo data. Your real workspace is untouched." : "Try a complete fictional workspace without changing your records."; color: root.demo-mode ? #8a571d : #52645b; font-size: root.body-font-size; }
                    if !root.demo-mode: Button { x: parent.width - 180px; y: 146px; width: 160px; height: 36px; text: "Open demo"; clicked => { root.enter-demo(); } }
