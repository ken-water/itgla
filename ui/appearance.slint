
import { Button, UiColors } from "controls.slint";

component AppearancePreview inherits Rectangle {
    in property <length> row-height: 42px;
    height: 36px + root.row-height * 2;
    background: UiColors.surface; border-width: 1px; border-color: UiColors.border; border-radius: 4px;
    VerticalLayout {
        spacing: 0px;
        Rectangle { height: 36px; background: UiColors.raised;
            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: "Server / Environment / Status"; color: UiColors.muted; font-size: UiColors.body-size; vertical-alignment: center; }
        }
        for name in ["app-01", "db-01"]: Rectangle {
            height: root.row-height;
            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: name + "     Production     Active"; color: UiColors.text; font-size: UiColors.body-size; vertical-alignment: center; }
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: UiColors.border; }
        }
    }
}

export component AppearanceControls inherits Rectangle {
    in-out property <int> theme-index;
    in-out property <int> font-size-step;
    in-out property <int> table-density;
    out property <length> preview-row-height: root.table-density == 0 ? 34px : root.table-density == 1 ? 42px : 50px;
    callback edited;
    background: transparent;
    HorizontalLayout {
      spacing: 28px;
      VerticalLayout {
        width: root.width > 750px ? root.width * 0.55 : root.width; spacing: 8px;
        Text { text: "Color theme"; color: UiColors.text; font-size: UiColors.body-size; font-weight: 650; }
        HorizontalLayout {
            height: 52px; spacing: 8px;
            for theme[index] in ["Field Atlas", "Slate", "Sand", "Contrast", "Dark"]: Button {
                horizontal-stretch: 1; height: 52px; label-size: UiColors.body-size;
                text: index == 0 ? "Atlas" : theme; accessible-label: "Color: " + (index == 0 ? "Field Atlas" : theme);
                swatch: index == 0 ? #183c32 : index == 1 ? #285a98 : index == 2 ? #b99357 : index == 3 ? #000000 : #34485c;
                accessible-checkable: true; checked: root.theme-index == index;
                clicked => { root.theme-index = index; root.edited(); }
            }
        }
        Text { text: "Text size: " + ["Small", "Medium", "Large"][max(0, min(2, root.font-size-step - 1))] + " / " + max(1, min(3, root.font-size-step)) + " of 3"; accessible-label: "Text size"; accessible-role: text; color: UiColors.text; font-size: UiColors.body-size; font-weight: 650; }
        size-control := Rectangle {
            height: 76px; background: transparent;
            accessible-role: slider; accessible-label: "Text size control";
            accessible-value: root.font-size-step;
            accessible-value-minimum: 1; accessible-value-maximum: 3; accessible-value-step: 1;
            accessible-action-set-value(v) => { if v.is-float() { root.font-size-step = round(max(1, min(3, v.to-float()))); root.edited(); } }
            accessible-action-increment => { root.font-size-step = min(3, root.font-size-step + 1); root.edited(); }
            accessible-action-decrement => { root.font-size-step = max(1, root.font-size-step - 1); root.edited(); }
            forward-focus: size-focus;
            Rectangle { x: 22px; y: 20px; width: parent.width - 44px; height: 4px; background: UiColors.border; border-radius: 2px; }
            for size[index] in ["1", "2", "3"]: Rectangle {
                x: (parent.width - 44px) * index / 2; width: 44px; height: 76px;
                Rectangle { x: 18px; y: 18px; width: 8px; height: 8px; background: UiColors.primary; border-radius: 4px; }
                Text { y: 40px; width: parent.width; height: 32px; text: size; horizontal-alignment: center; vertical-alignment: center; color: root.font-size-step == index + 1 ? UiColors.text : UiColors.muted; font-size: [12px, 13px, 15px][index]; font-weight: root.font-size-step == index + 1 ? 750 : 500; }
            }
            Rectangle { x: 10px + (parent.width - 44px) * (max(1, min(3, root.font-size-step)) - 1) / 2; y: 10px; width: 24px; height: 24px; background: UiColors.primary; border-width: size-focus.has-focus ? 3px : 2px; border-color: size-focus.has-focus ? UiColors.focus : UiColors.surface; border-radius: 12px; }
            size-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { size-focus.focus(); root.font-size-step = 1 + round(max(0, min(2, (self.mouse-x - 22px) / (self.width - 44px) * 2))); root.edited(); } }
                moved => { if self.pressed { root.font-size-step = 1 + round(max(0, min(2, (self.mouse-x - 22px) / (self.width - 44px) * 2))); root.edited(); } }
            }
            size-focus := FocusScope { width: 0px;
                key-pressed(event) => {
                    if event.text == Key.RightArrow || event.text == Key.UpArrow { root.font-size-step = min(3, root.font-size-step + 1); root.edited(); return accept; }
                    if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.font-size-step = max(1, root.font-size-step - 1); root.edited(); return accept; }
                    if event.text == Key.Home { root.font-size-step = 1; root.edited(); return accept; }
                    if event.text == Key.End { root.font-size-step = 3; root.edited(); return accept; }
                    return reject;
                }
            }
        }
        HorizontalLayout {
            height: 36px; spacing: 6px;
            Text { text: "Row spacing"; color: UiColors.text; font-size: UiColors.body-size; vertical-alignment: center; }
            for density[index] in ["Compact", "Comfy", "Roomy"]: Button {
                horizontal-stretch: 1; height: 36px; label-size: UiColors.body-size;
                text: density; accessible-label: "Row spacing: " + density;
                accessible-checkable: true; checked: root.table-density == index;
                clicked => { root.table-density = index; root.edited(); }
            }
        }
        if root.width <= 750px: Text { text: "Preview"; color: UiColors.muted; font-size: UiColors.body-size; }
        if root.width <= 750px: AppearancePreview { row-height: root.preview-row-height; }
      }
      if root.width > 750px: VerticalLayout {
        width: root.width * 0.42; spacing: 12px;
        Text { text: "Preview"; color: UiColors.muted; font-size: UiColors.body-size; }
        AppearancePreview { row-height: root.preview-row-height; }
        Rectangle { vertical-stretch: 1; background: transparent; }
      }
    }
}
