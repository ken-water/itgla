import { Slider } from "std-widgets.slint";
import { Button, UiColors } from "controls.slint";

component AppearancePreview inherits Rectangle {
    in property <length> row-height: 42px;
    height: 36px + root.row-height * 2;
    background: UiColors.surface; border-width: 1px; border-color: UiColors.border; border-radius: 4px;
    VerticalLayout {
        spacing: 0px;
        Rectangle { height: 36px; background: UiColors.raised;
            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: "Server / Environment / Status"; color: UiColors.muted; font-size: UiColors.body-size; vertical-alignment: center; }
        }
        for name in ["app-01", "db-01"]: Rectangle {
            height: root.row-height;
            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: name + "     Production     Active"; color: UiColors.text; font-size: UiColors.body-size; vertical-alignment: center; }
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: UiColors.border; }
        }
    }
}

export component AppearanceControls inherits Rectangle {
    in-out property <int> theme-index;
    in-out property <int> font-size-step;
    in-out property <int> table-density;
    out property <length> preview-row-height: root.table-density == 0 ? 34px : root.table-density == 1 ? 42px : 50px;
    callback edited;
    background: transparent;
    HorizontalLayout {
      spacing: 28px;
      VerticalLayout {
        width: root.width > 750px ? root.width * 0.55 : root.width; spacing: 8px;
        Text { text: "Color theme"; color: UiColors.text; font-size: UiColors.body-size; font-weight: 650; }
        HorizontalLayout {
            height: 52px; spacing: 8px;
            for theme[index] in ["Field Atlas", "Slate", "Sand", "Contrast", "Dark"]: Button {
                horizontal-stretch: 1; height: 52px; label-size: UiColors.body-size;
                text: index == 0 ? "Atlas" : theme; accessible-label: "Color: " + (index == 0 ? "Field Atlas" : theme);
                swatch: index == 0 ? #183c32 : index == 1 ? #285a98 : index == 2 ? #b99357 : index == 3 ? #000000 : #34485c;
                accessible-checkable: true; checked: root.theme-index == index;
                clicked => { root.theme-index = index; root.edited(); }
            }
        }
        Text { text: "Text size: " + ["Small", "Medium", "Large", "Extra large", "Largest"][root.font-size-step] + " · " + (root.font-size-step + 1) + " of 5"; accessible-label: "Text size"; accessible-role: text; color: UiColors.text; font-size: UiColors.body-size; font-weight: 650; }
        Slider {
            height: 32px; minimum: 0; maximum: 4; step: 1;
            value: root.font-size-step;
            accessible-label: "Text size control";
            changed(value) => { root.font-size-step = round(value); root.edited(); }
        }
        Rectangle {
            height: 32px; background: transparent;
            for size[index] in ["1", "2", "3", "4", "5"]: Text {
                x: 2px + (parent.width - 24px) * index / 4; width: 20px; height: 32px;
                text: size; horizontal-alignment: center;
                color: root.font-size-step == index ? UiColors.text : UiColors.muted; font-size: [11px, 12px, 13px, 15px, 17px][index]; vertical-alignment: center;
            }
        }
        HorizontalLayout {
            height: 36px; spacing: 6px;
            Text { text: "Row spacing"; color: UiColors.text; font-size: UiColors.body-size; vertical-alignment: center; }
            for density[index] in ["Compact", "Comfy", "Roomy"]: Button {
                horizontal-stretch: 1; height: 36px; label-size: UiColors.body-size;
                text: density; accessible-label: "Row spacing: " + density;
                accessible-checkable: true; checked: root.table-density == index;
                clicked => { root.table-density = index; root.edited(); }
            }
        }
        if root.width <= 750px: Text { text: "Preview"; color: UiColors.muted; font-size: UiColors.body-size; }
        if root.width <= 750px: AppearancePreview { row-height: root.preview-row-height; }
      }
      if root.width > 750px: VerticalLayout {
        width: root.width * 0.42; spacing: 12px;
        Text { text: "Preview"; color: UiColors.muted; font-size: UiColors.body-size; }
        AppearancePreview { row-height: root.preview-row-height; }
        Rectangle { vertical-stretch: 1; background: transparent; }
      }
    }
}
