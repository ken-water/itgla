// Semantic action colors are shared by all desktop pages. Inputs stay white.
export global UiColors {
    out property <color> surface: #fbfcf9;
    out property <color> text: #203c30;
    out property <color> muted: #52645b;
    out property <color> action: #dce8df;
    out property <color> action-hover: #ccdcd0;
    out property <color> action-pressed: #bdd0c2;
    out property <color> action-border: #718579;
    out property <color> primary: #245947;
    out property <color> primary-hover: #1b4838;
    out property <color> primary-pressed: #123829;
    out property <color> on-primary: #ffffff;
    out property <color> focus: #0f7665;
    out property <color> disabled: #e4e8e3;
    out property <color> disabled-text: #68756b;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> checkable: false;
    in-out property <bool> checked: false;
    in property <color> swatch: transparent;
    in property <length> label-size: 13px;
    out property <bool> has-focus: button-focus.has-focus;
    out property <bool> pressed: root.enabled && button-touch.pressed;
    callback clicked;
    public function activate() {
        if root.enabled {
            if root.checkable { root.checked = !root.checked; }
            root.clicked();
        }
    }
    min-width: 28px; min-height: 28px;
    preferred-width: button-label.preferred-width + 24px;
    preferred-height: 36px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 5px;
    border-width: root.has-focus ? 2px : 1px;
    border-color: root.has-focus ? UiColors.focus : !root.enabled ? #bdc8be : UiColors.action-border;
    background: !root.enabled ? UiColors.disabled : root.primary || root.checked ?
        (root.pressed ? UiColors.primary-pressed : button-touch.has-hover ? UiColors.primary-hover : UiColors.primary) :
        (root.pressed ? UiColors.action-pressed : button-touch.has-hover ? UiColors.action-hover : UiColors.action);
    forward-focus: button-focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { root.activate(); }
    if root.has-focus: Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; background: transparent; border-radius: 7px; border-width: 2px; border-color: UiColors.focus; }
    // A lower edge reinforces the raised action shape without a glowing shadow.
    Rectangle { x: 2px; y: parent.height - 3px; width: parent.width - 4px; height: 1px; background: root.enabled && !root.pressed ? UiColors.action-border : transparent; }
    if root.swatch != transparent: Rectangle { x: 10px; y: 7px; width: parent.width - 20px; height: 7px; background: root.swatch; border-radius: 2px; border-width: 1px; border-color: root.checked ? #dce8df : UiColors.action-border; }
    button-label := Text {
        x: 5px; y: root.swatch != transparent ? 17px : root.pressed ? 1px : 0px;
        width: parent.width - 10px; height: parent.height - self.y - (root.swatch != transparent ? 3px : 0px);
        text: root.text; font-size: root.label-size; font-weight: 600;
        color: !root.enabled ? UiColors.disabled-text : root.primary || root.checked ? UiColors.on-primary : UiColors.text;
        horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
        accessible-role: none;
    }
    button-touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.activate(); } }
    button-focus := FocusScope {
        width: 0px; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return { root.activate(); return accept; }
            return reject;
        }
    }
}
